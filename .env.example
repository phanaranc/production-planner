# Copy to .env for local (non-Docker) `npm run dev`, pointed at the
# dockerized db's HOST port (5440). Inside docker-compose, the app container
# gets its own DATABASE_URL (pointing at db:5432) via docker-compose.yml.
DATABASE_URL="postgresql://ppwm:ppwm_dev_local@localhost:5440/production_planner?schema=public"

# Any long random string. Rotate before real deployment.
SESSION_SECRET="dev-only-secret-change-me"

# The app computes "today"/"this month" boundaries from server-local time —
# pin it to Thailand regardless of the dev machine's own OS timezone (the
# Docker containers pin this too, in docker-compose.yml/Dockerfile).
TZ="Asia/Bangkok"
